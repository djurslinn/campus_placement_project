# ── Campus Placement Project — Environment Variables ──────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Django Core ───────────────────────────────────────────────────────────
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-strong-random-secret-key-here

# Set to False in production. True enables the dev OTP display on screen.
DEBUG=True

# Comma-separated. In production use your real domain, e.g.: .onrender.com,yourdomain.com
# Do NOT use * in production — the app will refuse to start.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (required in production).
# Example: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# ── Database (local PostgreSQL) ───────────────────────────────────────────
# Used when DATABASE_URL is not set. All fields are optional in dev;
# DB_PASSWORD is required in production.
DB_NAME=campus_placement
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Database (cloud deployments) ─────────────────────────────────────────
# If set, overrides the individual DB_* variables above.
# Render/Railway/Heroku set this automatically.
DATABASE_URL=

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────
# Step 1: Enable 2-Step Verification on your Google account.
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Create an App Password (select "Mail").
# Step 4: Paste the 16-character password below.
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=Campus Placement <your_email@gmail.com>

# ── ATS Microservice ──────────────────────────────────────────────────────
# URL of the FastAPI ATS service. Change to your deployed URL in production.
ATS_SERVICE_URL=http://127.0.0.1:8001

# ── OTP Security (optional overrides) ────────────────────────────────────
# OTP_EXPIRY_SECONDS=600    # 10 minutes
# OTP_MAX_ATTEMPTS=5        # lock after N wrong attempts
# OTP_RESEND_COOLDOWN=60    # seconds before another OTP can be requested

# ── ATS Service CORS (used by ats-ai-service/main.py) ────────────────────
# Comma-separated list of allowed origins for the FastAPI CORS middleware.
# ALLOWED_ORIGINS=http://localhost:8000,https://yourdomain.com
